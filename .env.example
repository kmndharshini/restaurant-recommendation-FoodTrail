# Copy this file to .env and fill in your actual keys.
# Get your free Groq API key at: https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# Groq-hosted models (pick one supported by your GroqCloud account):
#   openai/gpt-oss-20b   — ultra-fast 20B MoE model (default)
#   openai/gpt-oss-120b  — high-capacity 120B model
#   qwen/qwen3.8-27b     — 27B reasoning model
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

MAX_CANDIDATES=15
MAX_LLM_TOKENS=800
DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
PROCESSED_DATA_PATH=data/processed/restaurants.parquet
